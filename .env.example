# Supabase Project Configuration (Required)
# Find these in your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Allowed College Email Domains (Comma-separated, e.g. stanford.edu,mit.edu or edu)
# Defaults to "edu" if omitted. Supports exact domains (e.g. campus.edu) or domain suffixes (e.g. edu, ac.in).
VITE_ALLOWED_EMAIL_DOMAINS=edu

# Optional Campus Display Label
VITE_CAMPUS_NAME=CampusConnect
